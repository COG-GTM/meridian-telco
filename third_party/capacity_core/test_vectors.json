{
  "version": 1,
  "rule": {
    "available_mbps": "max(total_mbps - allocated_mbps - maintenance_buffer_mbps, 0)",
    "utilization_pct": "(allocated_mbps + maintenance_buffer_mbps) * 100 / total_mbps, rounded to 2 decimals half to even on the exact value; 0 when total_mbps <= 0",
    "can_support": "requested_mbps <= available_mbps"
  },
  "cases": [
    {
      "name": "vantage_reference_riv01",
      "total_mbps": 1000,
      "allocated_mbps": 600,
      "maintenance_buffer_mbps": 150,
      "requested_mbps": 250,
      "expect_available_mbps": 250,
      "expect_utilization_pct": 75.0,
      "expect_can_support": true
    },
    {
      "name": "legacy_row_without_buffer",
      "total_mbps": 1000,
      "allocated_mbps": 600,
      "maintenance_buffer_mbps": 0,
