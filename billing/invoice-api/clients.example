# invoice-api clients. copy to billing/invoice-api/clients.conf (gitignored),
# chmod 600, and replace the tokens. one caller per line:
#
#   <caller-id> <token> <* | ACCT_ID[,ACCT_ID...]>
#
# tokens must be at least 32 characters, e.g.
#   head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
# scope * lets the caller see every account, otherwise only the listed ones.

# finance-register  REPLACE_WITH_RANDOM_TOKEN_OF_32_PLUS_CHARS  *
# beacon-portal     REPLACE_WITH_RANDOM_TOKEN_OF_32_PLUS_CHARS  BEACON-004417
